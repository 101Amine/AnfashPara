# Copy this file to `.dev.vars` for local-only overrides.
# Never commit real secrets or production credentials.
ENVIRONMENT=local
GIT_SHA=uncommitted
# Required by the /admin/* Cloudflare Access JWT middleware.
# Team domain accepts either anfashpara.cloudflareaccess.com or the HTTPS URL.
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=
# HMAC secret for POST /api/webhooks/orders. Generate a long random value locally.
ORDER_WEBHOOK_SECRET=
# Courier adapter credentials. Keep real values in Wrangler secrets.
COURIER_NAME=
COURIER_API_URL=
COURIER_ACCOUNT_ID=
COURIER_API_TOKEN=
